# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend Email API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Keystatic CMS (for production GitHub storage mode)
# Enables the /keystatic editor login → commit-to-GitHub → deploy flow.
# See: https://keystatic.com/docs/github-mode
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Repo the CMS writes to (defaults are used if unset)
KEYSTATIC_GITHUB_REPO_OWNER=aresnik-mimokin
KEYSTATIC_GITHUB_REPO_NAME=PeopleFirst-Website

# Optional: Site URL for sitemap generation
NEXT_PUBLIC_SITE_URL=https://wearepeoplefirst.com
